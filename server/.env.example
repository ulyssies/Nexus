# ════════════════════════════════════════════════════════════════
#  Nexus secrets template — copy to server/.env and fill in.
#  server/.env is gitignored; this file (no values) is the shipped guide.
#  Empty values are treated as "not set" — agents skip gracefully.
#  (Gmail is the one exception: it uses a separate credentials.json,
#   not an env var — see the Phase 5 block below.)
# ════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────
PORT=3001
# NEXUS_DB_PATH=                 # optional: override SQLite path (default server/db/nexus.db)

# ── Phase 2 · Job agent ──────────────────────────────────────────
ANTHROPIC_API_KEY=               # console.anthropic.com → API keys. Powers EVERY agent.
ADZUNA_APP_ID=                   # developer.adzuna.com → register (free tier, 250 req/day)
ADZUNA_APP_KEY=                  # ^ same page. (The Muse + Jobicy need no key.)

# Optional — email digest of the 3-day job report (Nodemailer). Runs fine without these.
EMAIL_USER=                      # your Gmail address (sends the report)
EMAIL_APP_PASSWORD=              # 16-char app password: myaccount.google.com/apppasswords (needs 2FA)
EMAIL_RECIPIENT=                 # where the report lands (can be the same address)

# ── Phase 5 · Morning brief agent ────────────────────────────────
NEWS_API_KEY=                    # newsapi.org free dev tier (or GNews / Currents)

# ── Phase 5 · Email agent (Gmail, READ-ONLY) ─────────────────────
# Not an env key. In Google Cloud Console: new project → enable Gmail API →
# OAuth consent screen (External, add yourself as a test user) → create
# OAuth *Desktop* credentials → download as  server/credentials.json .
# First run opens a browser to authorize; the token caches locally.
# Scope stays gmail.readonly — the agent never sends or deletes.

# ── Phase 6 · Project archivist ──────────────────────────────────
# Not a secret. Set the absolute folder paths to watch in  server/config.js , e.g.
#   export const WATCHED_PROJECTS = [{ name: 'nexus', path: '/Users/you/Nexus', type: 'git' }]

# ── One-time legacy import (optional) ────────────────────────────
# JOBS_JSON_PATH=                # path to an old job-agent jobs.json for: npm run migrate:jobs
